{
  "name": "bihar-assembly-cms-server",
  "version": "1.0.0",
  "description": "Bihar Assembly Application & Complaint Management System Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "serve": "node dist/index.js",
    "db:setup": "ts-node src/scripts/init-database.ts && ts-node src/scripts/seed-bihar-master.ts",
    "seed:admin": "ts-node src/scripts/seed-admin.ts",
    "seed:master": "ts-node src/scripts/seed-bihar-master.ts",
    "db:clear": "ts-node src/scripts/clear-demo-data.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
